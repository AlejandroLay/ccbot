<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.usuario.ccbot</string>

    <!-- launchd NO expande ~ ni $HOME: todas las rutas van absolutas -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/alejandrolay/ccbot/.venv/bin/python</string>
        <string>/Users/alejandrolay/ccbot/cc_bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/alejandrolay/ccbot</string>

    <!-- cada 10 minutos -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/alejandrolay/ccbot/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/alejandrolay/ccbot/launchd.err.log</string>
</dict>
</plist>
